# AppArmor profiles for ticktick-cli running under the bun runtime.
#
# Two profiles, selected by /usr/bin/ticktick on the command line. Neither
# carries an attachment path on purpose: they are applied explicitly with
# `aa-exec -p`, which keeps the wrapper the single entry point and avoids
# attaching anything to the shared /usr/bin/bun binary.
#
# Shared rules live in abstractions/ticktick-cli.

abi <abi/4.0>,

include <tunables/global>

# Everyday profile: every subcommand except `auth login`.
#
# `open` is imported in exactly one place upstream (commands/auth.js, reached
# only from `auth login`) and nothing else in the CLI spawns a process, so
# this profile carries no exec rule at all and cannot start any program.
profile ticktick-cli {
	include <abstractions/ticktick-cli>

	# abstractions/nameservice grants blanket 'network inet stream' because
	# it needs TCP for DNS, and that would otherwise permit a listening
	# socket. deny overrides allow in AppArmor, so this pins the everyday
	# profile to outbound connections only: it can reach api.ticktick.com
	# but cannot open a port.
	deny network (bind,listen,accept) inet  stream,
	deny network (bind,listen,accept) inet6 stream,
}

# Profile for `ticktick auth login` only.
#
# Two extra powers, both needed solely by the OAuth flow, and both denied to
# every other invocation by the profile above.
profile ticktick-cli-login {
	include <abstractions/ticktick-cli>

	# 1. The consent page is handed to the browser through xdg-open, which
	#    runs unconfined so the browser is not dragged into this profile.
	#    This is the one exec this package ever performs.
	/usr/bin/xdg-open                                   Ux,

	# 2. startCallbackServer() listens on 127.0.0.1:8765 for up to three
	#    minutes to catch the OAuth redirect, so bind/listen/accept are
	#    left in place here rather than denied.
}
